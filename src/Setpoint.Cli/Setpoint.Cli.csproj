<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Setpoint.Cli</RootNamespace>
    <!-- The executable name is what help prints in its usage lines. -->
    <AssemblyName>setpoint</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>setpoint</ToolCommandName>
    <PackageId>Setpoint</PackageId>
    <Title>Setpoint</Title>
    <Description>Repository governance as code for Azure DevOps Server, Azure DevOps Services and GitHub. Declare pull-request rules, repository access and deployment approvals once in YAML, then validate, plan and apply them across every repository.</Description>
    <PackageTags>governance;policy-as-code;github;azure-devops;branch-policy;rulesets;azure-devops-server;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/Quattordici/Setpoint/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Setpoint.Core\Setpoint.Core.csproj" />
    <ProjectReference Include="..\Setpoint.Adapters.GitHub\Setpoint.Adapters.GitHub.csproj" />
    <ProjectReference Include="..\Setpoint.Adapters.AzureDevOps\Setpoint.Adapters.AzureDevOps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
